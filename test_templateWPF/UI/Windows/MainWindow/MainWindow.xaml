<Window x:Class="test_templateWPF.UI.Windows.MainWindow.MainWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:test_templateWPF.UI.Windows.MainWindow"
             mc:Ignorable="d" 
             Style="{DynamicResource CustomMaterialDesignWindow}"
             d:DesignHeight="450" d:DesignWidth="800">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Styles;component/Styles/DesignTimeResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    
    
    <Grid>
        <Button Content="Button" Command="{Binding DoLogicCommand}" HorizontalAlignment="Left" Height="123" Margin="366,157,0,0" VerticalAlignment="Top" Width="222"/>

    </Grid>
</Window>
