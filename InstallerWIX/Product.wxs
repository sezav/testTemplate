<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
	<Product Id="*" Name="test_template" Language="1033" Version="$(var.ProductVersion)" Manufacturer="Tiver/Virtex" UpgradeCode="{B25FA1E3-19E6-4A5B-BE68-26672EC36E25}">
		<Package InstallerVersion="200" Compressed="yes" InstallScope="perMachine" />

		<MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed."
					  AllowSameVersionUpgrades="yes"
					  Schedule="afterInstallInitialize"/>
		<Media Id="1"
           Cabinet="media.cab"
           EmbedCab="yes" />

		<UIRef Id="WixUI_InstallDir_test_template"/>

		<PropertyRef Id="REVIT2022_INSTALLED"/>

			<Feature Id="Feature22"
					 Title="Revit 2022"
					 Level="10"
					 AllowAdvertise="no"
					 Absent='allow'>
				<Condition Level="1">REVIT2022_INSTALLED</Condition>
				<ComponentGroupRef Id="PublishedComponentsRevit2022" />
				<ComponentGroupRef Id="ResourcesRevit2022" />
				<ComponentRef Id="cmpAddin2022"/>
			</Feature>

	</Product>

	<Fragment>
		<?define Name="test_template"?>
		<Directory Id="TARGETDIR" Name="SourceDir">
			<Directory Id="AppDataFolder">
				<Directory Id="Autodesk" Name="Autodesk">
					<Directory Id="Revit" Name="Revit">
						<Directory Id="Addins" Name="Addins">
							<Directory Id ="Folder2022" Name="2022">
								<Directory Id="dll2022" Name="$(var.Name)">
									<Directory Id="REVIT2022FOLDER"/>
								</Directory>
								<Directory Id="REVIT2022_ADDIN_FOLDER" />
							</Directory>
						</Directory>
					</Directory>
				</Directory>
			</Directory>
		</Directory>
	</Fragment>
</Wix>
