<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
	<Product Id="*" Name="test_template" Language="1033" Version="$(var.ProductVersion)" Manufacturer="Tiver/Virtex" UpgradeCode="{B25FA1E3-19E6-4A5B-BE68-26672EC36E25}">
		<Package InstallerVersion="200" Compressed="yes" InstallScope="perMachine" />

		<MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed."
					  AllowSameVersionUpgrades="yes"
					  Schedule="afterInstallInitialize"/>
		<Media Id="1"
           Cabinet="media.cab"
           EmbedCab="yes" />

		<UIRef Id="WixUI_InstallDir_test_template"/>

		<PropertyRef Id="REVIT2019_INSTALLED"/>
		<PropertyRef Id="REVIT2020_INSTALLED"/>
		<PropertyRef Id="REVIT2021_INSTALLED"/>
		<PropertyRef Id="REVIT2022_INSTALLED"/>
		<PropertyRef Id="REVIT2023_INSTALLED"/>
		<PropertyRef Id="REVIT2024_INSTALLED"/>
		<PropertyRef Id="REVIT2025_INSTALLED"/>
		<PropertyRef Id="REVIT2026_INSTALLED"/>
		<PropertyRef Id="REVIT2027_INSTALLED"/>

		<Feature Id="FeatureRevit"
				 Title="Revit"
				 Level="1"
				 AllowAdvertise="no"
				 Absent="allow"
				 Display="expand">

			<Feature Id="Feature19"
				     Title="Revit 2019"
				     Level="10"
				     AllowAdvertise="no"
				     Absent='allow'>
				<Condition Level="1">REVIT2019_INSTALLED</Condition>
				<ComponentGroupRef Id="PublishedComponentsRevit2019" />
				<ComponentRef Id="cmpAddin2019"/>
			</Feature>
			
			<Feature Id="Feature20"
				     Title="Revit 2020"
				     Level="10"
				     AllowAdvertise="no"
				     Absent='allow'>
				<Condition Level="1">REVIT2020_INSTALLED</Condition>
				<ComponentGroupRef Id="PublishedComponentsRevit2020" />
				<ComponentRef Id="cmpAddin2020"/>
			</Feature>

			<Feature Id="Feature21"
					 Title="Revit 2021"
					 Level="10"
					 AllowAdvertise="no"
					 Absent='allow'>
				<Condition Level="1">REVIT2021_INSTALLED</Condition>
				<ComponentGroupRef Id="PublishedComponentsRevit2021" />
				<ComponentRef Id="cmpAddin2021"/>
			</Feature>

			<Feature Id="Feature22"
					 Title="Revit 2022"
					 Level="10"
					 AllowAdvertise="no"
					 Absent='allow'>
				<Condition Level="1">REVIT2022_INSTALLED</Condition>
				<ComponentGroupRef Id="PublishedComponentsRevit2022" />
				<ComponentGroupRef Id="ResourcesRevit2022" />
				<ComponentRef Id="cmpAddin2022"/>
			</Feature>

			<Feature Id="Feature23"
				 Title="Revit 2023"
				 Level="10"
				 AllowAdvertise="no"
				 Absent='allow'>
				<Condition Level="1">REVIT2023_INSTALLED</Condition>
				<ComponentGroupRef Id="PublishedComponentsRevit2023" />
				<ComponentRef Id="cmpAddin2023"/>
			</Feature>

			<Feature Id="Feature24"
				 Title="Revit 2024"
				 Level="10"
				 AllowAdvertise="no"
				 Absent='allow'>
				<Condition Level="1">REVIT2024_INSTALLED</Condition>
				<ComponentGroupRef Id="PublishedComponentsRevit2024" />
				<ComponentRef Id="cmpAddin2024"/>
			</Feature>

			<Feature Id="Feature25"
				 Title="Revit 2025"
				 Level="10"
				 AllowAdvertise="no"
				 Absent='allow'>
				<Condition Level="1">REVIT2025_INSTALLED</Condition>
				<ComponentGroupRef Id="PublishedComponentsRevit2025" />
				<ComponentRef Id="cmpAddin2025"/>
			</Feature>

			<Feature Id="Feature26"
				 Title="Revit 2026"
				 Level="10"
				 AllowAdvertise="no"
				 Absent='allow'>
				<Condition Level="1">REVIT2026_INSTALLED</Condition>
				<ComponentGroupRef Id="PublishedComponentsRevit2026" />
				<ComponentRef Id="cmpAddin2026"/>
			</Feature>

			<Feature Id="Feature27"
				 Title="Revit 2027"
				 Level="10"
				 AllowAdvertise="no"
				 Absent='allow'>
				<Condition Level="1">REVIT2027_INSTALLED</Condition>
				<ComponentGroupRef Id="PublishedComponentsRevit2027" />
				<ComponentRef Id="cmpAddin2027"/>
			</Feature>
			<ComponentRef Id="cmpRegisterVersion" />
		</Feature>
	</Product>

	<Fragment>
		<?define Name="test_template"?>
		<Directory Id="TARGETDIR" Name="SourceDir">
			<Directory Id="AppDataFolder">
				<Directory Id="Autodesk" Name="Autodesk">
					<Directory Id="Revit" Name="Revit">
						<Directory Id="Addins" Name="Addins">
							<Directory Id ="Folder2019" Name="2019">
								<Directory Id="dll2019" Name="$(var.Name)">
									<Directory Id="REVIT2019FOLDER"/>
								</Directory>
								<Directory Id="REVIT2019_ADDIN_FOLDER" />
							</Directory>
							<Directory Id ="Folder2020" Name="2020">
								<Directory Id="dll2020" Name="$(var.Name)">
									<Directory Id="REVIT2020FOLDER"/>
								</Directory>
								<Directory Id="REVIT2020_ADDIN_FOLDER" />
							</Directory>
							<Directory Id ="Folder2021" Name="2021">
