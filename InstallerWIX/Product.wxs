									<Directory Id="REVIT2021FOLDER"/>
								</Directory>
								<Directory Id="REVIT2021_ADDIN_FOLDER" />
							</Directory>
							<Directory Id ="Folder2022" Name="2022">
								<Directory Id="dll2022" Name="$(var.Name)">
									<Directory Id="REVIT2022FOLDER"/>
								</Directory>
								<Directory Id="REVIT2022_ADDIN_FOLDER" />
							</Directory>
							<Directory Id ="Folder2023" Name="2023">
								<Directory Id="dll2023" Name="$(var.Name)">
									<Directory Id="REVIT2023FOLDER"/>
								</Directory>
								<Directory Id="REVIT2023_ADDIN_FOLDER" />
							</Directory>
							<Directory Id ="Folder2024" Name="2024">
								<Directory Id="dll2024" Name="$(var.Name)">
									<Directory Id="REVIT2024FOLDER"/>
								</Directory>
								<Directory Id="REVIT2024_ADDIN_FOLDER" />
							</Directory>
							<Directory Id ="Folder2025" Name="2025">
								<Directory Id="dll2025" Name="$(var.Name)">
									<Directory Id="REVIT2025FOLDER"/>
								</Directory>
								<Directory Id="REVIT2025_ADDIN_FOLDER" />
							</Directory>
							<Directory Id ="Folder2026" Name="2026">
								<Directory Id="dll2026" Name="$(var.Name)">
									<Directory Id="REVIT2026FOLDER"/>
								</Directory>
								<Directory Id="REVIT2026_ADDIN_FOLDER" />
							</Directory>
							<Directory Id ="Folder2027" Name="2027">
								<Directory Id="dll2027" Name="$(var.Name)">
									<Directory Id="REVIT2027FOLDER"/>
								</Directory>
								<Directory Id="REVIT2027_ADDIN_FOLDER" />
							</Directory>
