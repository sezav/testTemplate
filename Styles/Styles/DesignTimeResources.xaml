<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:local="clr-namespace:Styles.UI.Styles"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Styles.UI.Styles.DesignTimeResources">

    <ResourceDictionary.MergedDictionaries>
        <materialDesign:CustomColorTheme BaseTheme="Light" 
         PrimaryColor="#FF1C1C1C" 
         SecondaryColor="White" />
        <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
    </ResourceDictionary.MergedDictionaries>


    <Style x:Key="CustomMaterialDesignWindow" BasedOn="{StaticResource MaterialDesignWindow}" TargetType="Window" >
        <Setter Property="WindowStyle" Value="None"/>
        <Setter Property="AllowsTransparency" Value="True"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="ResizeMode" Value="NoResize"/>
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontFamily" Value="Calibri"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Window">
                    <Border Background="{TemplateBinding Background}"
                            BorderThickness="1"
                            BorderBrush="Black"
                            >
                        <Grid>
                            <Border Background="#FF1C1C1C" Height="30" VerticalAlignment="Top" MouseDown="Border_MouseDown"
                                    Tag="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}">

                                <Grid>
                                    <Image Source="../../Resource/Icon/test2.png" 
                                           Width="20" 
                                           Height="20" 
                                           VerticalAlignment="Center" 
                                           HorizontalAlignment="Left" 
                                           Margin="5,0,0,0"/>
                                    
                                    <TextBlock Text="{TemplateBinding Title}" 
                                               VerticalAlignment="Center" 
                                               HorizontalAlignment="Left" 
                                               Margin="30,0,0,0" 
                                               Foreground="White"/>


                                    <local:CustomWindowButtons HorizontalAlignment="Right" 
                                                               VerticalAlignment="Center" 
                                                               Margin="0,0,10,0"/>
                                </Grid>
                            </Border>

                            <ContentPresenter Margin="0,30,0,0"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>